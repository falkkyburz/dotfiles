#!/usr/bin/env bash

set -u

pids=()

cleanup() {
  trap - EXIT INT TERM

  echo
  echo "Stopping CPU load..."

  for pid in "${pids[@]}"; do
    kill "$pid" 2>/dev/null || true
  done

  wait 2>/dev/null || true
  echo "Stopped."
}

trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

cores="$(nproc)"
echo "Starting CPU load on $cores cores."
echo "Press Ctrl-C to stop."

for _ in $(seq 1 "$cores"); do
  yes > /dev/null &
  pids+=("$!")
done

wait
