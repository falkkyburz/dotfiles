#!/usr/bin/env bash
set -euo pipefail

workdir="$HOME/Work"

repos=(
  "Hyprland https://github.com/hyprwm/Hyprland.git"
  "aquamarine https://github.com/hyprwm/aquamarine.git"
  "hypridle https://github.com/hyprwm/hypridle.git"
  "hyprlauncher https://github.com/falkkyburz/hyprlauncher.git"
  "hyprlock https://github.com/falkkyburz/hyprlock.git"
  "hyprpaper https://github.com/hyprwm/hyprpaper.git"
  "hyprpicker https://github.com/hyprwm/hyprpicker.git"
  "hyprpolkitagent https://github.com/hyprwm/hyprpolkitagent.git"
  "hyprscreenpicker https://github.com/falkkyburz/hyprscreenpicker.git"
  "hyprtoolkit https://github.com/hyprwm/hyprtoolkit.git"
  "hyprutils https://github.com/hyprwm/hyprutils.git"
  "xdg-desktop-portal-hyprland https://github.com/hyprwm/xdg-desktop-portal-hyprland.git"
)

mkdir -p "$workdir"

for repo in "${repos[@]}"; do
  name="${repo%% *}"
  url="${repo#* }"
  dest="$workdir/$name"

  if [[ -d "$dest/.git" ]]; then
    printf '%s already exists; skipping\n' "$dest"
    continue
  fi

  if [[ -e "$dest" ]]; then
    printf '%s exists but is not a git repository; skipping\n' "$dest" >&2
    continue
  fi

  git clone "$url" "$dest"
done
